#!/bin/sh
# herdr-shell: hc's configured `shell`, so every new terminal and every keep
# recovery starts here. It reads its own terminal with `hc get`. A suspended
# agent's terminal (label herdr.suspended) gets the stand-in installed next to
# this file; any other terminal gets $SHELL. No shell starts unless hc answered
# without the label, so a message sent to a suspended agent never runs as a
# command.

case $0 in */*) standin=${0%/*}/herdr-standin ;; *) standin=./herdr-standin ;; esac

# Reads hc's JSON answer (one terminal) and prints "absent", or "suspended"
# and then the address, the name and the label's agent, one per line.
# Fails when the answer is not a terminal object.
parse='
function str(t,   out, c) {
  t = substr(t, 2, length(t) - 2); out = ""
  while (match(t, /\\/)) {
    out = out substr(t, 1, RSTART - 1); c = substr(t, RSTART + 1, 1)
    if (c == "u") { out = out "?"; t = substr(t, RSTART + 6); continue }
    out = out (c ~ /[bfnrt]/ ? "?" : c); t = substr(t, RSTART + 2)
  }
  return out t
}
{ s = s $0 "\n" }
END {
  while (s != "") {
    if (match(s, /^[ \t\r\n]+/)) { s = substr(s, RLENGTH + 1); continue }
    if (match(s, /^"([^"\\]|\\.)*"/) || match(s, /^[][{}:,]/) || match(s, /^[^][{}:," \t\r\n]+/)) {
      tok = substr(s, 1, RLENGTH); s = substr(s, RLENGTH + 1)
    } else exit 1
    if (tok == "{" || tok == "[") { if (!depth && tok != "{") exit 1; top = 1; kind[++depth] = tok; want_key = tok == "{"; continue }
    if (tok == "}" || tok == "]") { if (--depth < 0) exit 1; continue }
    if (tok == ",") { want_key = kind[depth] == "{"; continue }
    if (tok == ":" || !depth) continue
    if (want_key) { key[depth] = tok; want_key = 0; continue }
    if (depth == 1 && key[1] == "\"address\"") address = str(tok)
    if (depth == 1 && key[1] == "\"name\"" && tok != "null") name = str(tok)
    if (depth == 2 && key[1] == "\"labels\"" && key[2] == "\"herdr.suspended\"") { found = 1; label = str(tok) }
  }
  if (!top || depth || address == "") exit 1
  if (!found) { print "absent"; exit }
  agent = ""
  if (match(label, /"agent"[ ]*:[ ]*"[A-Za-z0-9_.-]*"/)) {
    agent = substr(label, RSTART, RLENGTH); sub(/^"agent"[ ]*:[ ]*"/, "", agent); sub(/"$/, "", agent)
  }
  print "suspended"; print address; print name; print agent; print "."
}'

# Sets out and rc from `hc get`. Exit code 5 (kind unavailable) means the core
# restarted while hc ran; that is retried for about 2 s. Other errors are not.
lookup() {
  tries=0
  while :; do
    out=$(hc get "$HC_TERMINAL_ID" --json 2>&1) && rc=0 || rc=$?
    retry=
    [ "$rc" -eq 5 ] && retry=1
    [ "$rc" -ne 0 ] && case $out in *'"kind":"unavailable"'*) retry=1 ;; esac
    [ -n "$retry" ] && [ "$tries" -lt 10 ] || return 0
    tries=$((tries + 1))
    sleep 0.2
  done
}

while :; do
  if [ -z "${HC_TERMINAL_ID:-}" ]; then
    problem='HC_TERMINAL_ID is not set, so this terminal cannot be checked'
  else
    lookup
    # In JSON text, a quote inside a string is always escaped, so the label's
    # key followed by a colon appears only where the label itself is. A
    # normal terminal skips the parser (about 5 ms) through this check.
    case $rc:$out in
      0:*'"herdr.suspended":'*) parsed=$(printf '%s\n' "$out" | awk "$parse") || parsed= ;;
      0:*'"labels":'*) parsed=absent ;;
      0:*) parsed= ;;
      *) parsed=failed ;;
    esac
    case $parsed in
      absent) exec "${SHELL:-/bin/sh}" "$@" ;;
      failed) problem="hc get $HC_TERMINAL_ID failed (exit $rc): $out" ;;
      suspended*)
        { IFS= read -r _; IFS= read -r address; IFS= read -r name; IFS= read -r agent; } <<EOF
$parsed
EOF
        [ -x "$standin" ] && exec "$standin" "$agent" "$address" "$name"
        problem="this agent is suspended, but the stand-in $standin is missing" ;;
      *) problem="hc get $HC_TERMINAL_ID gave an answer that cannot be read: $out" ;;
    esac
  fi
  printf 'herdr-shell: %s\n' "$problem" >&2
  printf 'herdr-shell: no shell was started, so no message can run as a command. Press Enter to try again.\n' >&2
  read -r _ || sleep 1
done
